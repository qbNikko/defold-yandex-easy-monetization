-keep,allowoptimization class com.yandex.mobile.ads.** { *; }
-keep,allowoptimization class com.my.target.** { *; }
-keep,allowoptimization class com.defold.extension.** { *; }

# Сохранение аннотаций
-keepattributes *Annotation*

# Сохранение сигнатур generic-типов
-keepattributes Signature

# Сохранение вложенных классов
-keepattributes InnerClasses,EnclosingMethod
